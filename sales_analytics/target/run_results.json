 "compile", "started_at": "2026-10-29T06:04:20.736595Z", "completed_at": "2026-10-29T06:04:20.755978Z"}, {"name": "execute", "started_at": "2026-10-29T06:04:20.763066Z", "completed_at": "2026-10-29T06:04:22.438183Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 1.7124965190887451, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c80c4c-0002-4474-000f-d7ca0013c3e6"}, "message": null, "failures": 0, "unique_id": "test.sales_analytics.assert_order_totals_match", "compiled": true, "compiled_code": "with line_sums as (\n    select\n        order_key,\n        sum(extended_price) as calculated_gross\n    from ANALYTICS.MARTS.fct_order_lines\n    group by 1\n),\n\norders as (\n    select\n        order_key,\n        total_price\n    from ANALYTICS.STAGING.stg_tpch__orders\n)\n\nselect\n    o.order_key,\n    o.total_price,\n    l.calculated_gross\nfrom orders o\njoin line_sums l on o.order_key = l.order_key\n-- TPC-H orders.total_price includes tax, so we allow a variance tolerance up to 20%\nwhere abs(o.total_price - l.calculated_gross) / nullif(o.total_price, 0) > 0.20", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-29T06:04:22.445473Z", "completed_at": "2026-10-29T06:04:22.450772Z"}, {"name": "execute", "started_at": "2026-10-29T06:04:22.451642Z", "completed_at": "2026-10-29T06:04:23.363070Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.9193851947784424, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c80c4c-0002-4474-000f-d7ca0013c40a"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.sales_analytics.rpt_region_sales_vs_target", "compiled": true, "compiled_code": "with actuals as (\n    select\n        region_name as region,\n        extract(year from order_date) as year,\n        sum(net_revenue) as actual_revenue\n    from ANALYTICS.MARTS.fct_order_lines\n    group by 1, 2\n),\n\ntargets as (\n    select\n        region,\n        year,\n        sales_target\n    from ANALYTICS.STAGING.stg_raw__region_targets\n)\n\nselect\n    coalesce(a.region, t.region) as region,\n    coalesce(a.year, t.year) as year,\n    coalesce(a.actual_revenue, 0) as actual_revenue,\n    coalesce(t.sales_target, 0) as sales_target,\n    actual_revenue - sales_target as variance,\n    case \n        when sales_target > 0 then (actual_revenue / sales_target) * 100 \n        else 0 \n    end as achievement_pct\nfrom actuals a\nfull outer join targets t on a.region = t.region and a.year = t.year", "relation_name": "ANALYTICS.MARTS.rpt_region_sales_vs_target", "batch_results": null}], "elapsed_time": 10.665256261825562, "args": {"include_saved_query": false, "static_parser": true, "resource_types": [], "show_resource_report": false, "project_dir": "/tmp/dbt", "printer_width": 80, "state_modified_compare_vars": false, "use_colors": true, "quiet": false, "indirect_selection": "eager", "introspect": true, "write_json": true, "version_check": true, "log_path": "/tmp/dbt/logs", "log_level": "info", "use_colors_file": true, "export_saved_queries": false, "skip_nodes_if_on_run_start_fails": false, "require_nested_cumulative_type_params": false, "profiles_dir": "/tmp/dbt_effective_profiles_myww7anv", "invocation_command": "dbt ", "require_batched_execution_for_custom_microbatch_strategy": false, "require_resource_names_without_spaces": false, "which": "build", "cache_selected_only": false, "exclude_resource_types": [], "state_modified_compare_more_unrendered_values": false, "send_anonymous_usage_stats": false, "partial_parse_file_diff": true, "warn_error_options": {"include": [], "exclude": []}, "favor_state": false, "log_level_file": "debug", "populate_cache": true, "show": false, "partial_parse": true, "log_file_max_bytes": 10485760, "require_explicit_package_overrides_for_builtin_materializations": true, "vars": {}, "empty": false, "exclude": [], "source