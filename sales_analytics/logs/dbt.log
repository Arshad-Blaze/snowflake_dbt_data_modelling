[0m23:04:22.458192 [debug] [Thread-2 (]: On model.sales_analytics.rpt_region_sales_vs_target: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "sales_analytics", "target_name": "dev", "node_id": "model.sales_analytics.rpt_region_sales_vs_target"} */
create or replace transient table ANALYTICS.MARTS.rpt_region_sales_vs_target
         as
        (with actuals as (
    select
        region_name as region,
        extract(year from order_date) as year,
        sum(net_revenue) as actual_revenue
    from ANALYTICS.MARTS.fct_order_lines
    group by 1, 2
),

targets as (
    select
        region,
        year,
        sales_target
    from ANALYTICS.STAGING.stg_raw__region_targets
)

select
    coalesce(a.region, t.region) as region,
    coalesce(a.year, t.year) as year,
    coalesce(a.actual_revenue, 0) as actual_revenue,
    coalesce(t.sales_target, 0) as sales_target,
    actual_revenue - sales_target as variance,
    case 
        when sales_target > 0 then (actual_revenue / sales_target) * 100 
        else 0 
    end as achievement_pct
from actuals a
full outer join targets t on a.region = t.region and a.year = t.year
        );
