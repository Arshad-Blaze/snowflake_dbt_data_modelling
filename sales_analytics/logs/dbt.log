select
      count(*) as failures,
      count(*) != 0 as should_warn,
      count(*) != 0 as should_error
    from (
      select
    order_key,
    line_number,
    net_revenue
from ANALYTICS.RAW_marts.fct_order_lines
where net_revenue < 0
      
    ) dbt_internal_test
[0m22:13:10.515503 [debug] [Thread-8 (]: Using snowflake connection "test.sales_analytics.unique_dim_regions_region_key.d7ef90e145"
[0m22:13:10.516537 [debug] [Thread-3 (]: On test.sales_analytics.assert_order_totals_match: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "sales_analytics", "target_name": "dev", "node_id": "test.sales_analytics.assert_order_totals_match"} */
select
      count(*) as failures,
      count(*) != 0 as should_warn,
      count(*) != 0 as should_error
    from (
      with line_sums as (
    select
        order_key,
        sum(extended_price) as calculated_gross
    from ANALYTICS.RAW_marts.fct_order_lines
    group by 1
),

orders as (
    select
        order_key,
        total_price
    from ANALYTICS.RAW_staging.stg_tpch__orders
)

select
    o.order_key,
    o.total_price,
    l.calculated_gross
from orders o
join line_sums l on o.order_key = l.order_key
-- TPC-H orders.total_price includes tax, so we allow a variance tolerance up to 20%
